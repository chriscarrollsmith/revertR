convert_RDS_to_RDA <- function() {
# Get a list of all .rda files in the directory
rda_files <- list.files(path = "./data")
# Iterate over each file
for (file in rds_files) {
# Load the file as 'data'
load(paste0("./data/", file))
# Get variable name from file name
varname <- stringr::str_remove(file ,".rda")
# Assign data object to dynamically constructed variable name
assign(varname, data)
# Save the object by its variable name
save(list = varname, file = paste0("./new/",file))
}
return(NULL)
}
convert_RDS_to_RDA()
rm(convert_RDS_to_RDA())
rm(convert_RDS_to_RDA)
copy_files <- function() {
# Get a list of all .rda files in the directory
rda_files <- list.files(path = "./data")
# Iterate over each file
for (file in rda_files) {
# Load the file as 'data'
load(paste0("./data/", file))
# Get variable name from file name
varname <- stringr::str_remove(file ,".rda")
# Assign data object to dynamically constructed variable name
assign(varname, data)
# Save the object by its variable name
save(list = varname, file = paste0("./new/",file))
}
return(NULL)
}
copy_files()
