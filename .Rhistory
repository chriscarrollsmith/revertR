convert_RDS_to_RDA <- function() {
# Set the directory to /data
data_dir <- "/data"
wd <- getwd()
# Get a list of all .rds files in the directory
rds_files <- list.files(path = paste0(wd,"/data"), pattern = "*.rda", full.names=TRUE, include.dirs=TRUE)
# Iterate over each file
for (file in rds_files) {
# rename the file
file.rename(from = file, to = stringr::str_replace(file,".rda",".rds"))
}
return(NULL)
}
convert_RDS_to_RDA()
convert_RDS_to_RDA <- function() {
# Set the directory to /data
data_dir <- "/data"
wd <- getwd()
# Get a list of all .rds files in the directory
rds_files <- list.files(path = paste0(wd,"/data"), pattern = "*.rds", full.names=TRUE, include.dirs=TRUE)
# Iterate over each file
for (file in rds_files) {
# Read the .rds file
data <- readRDS(file)
# Save the data as .rda using usethis::use_data()
usethis::use_data(data,overwrite=TRUE)
# rename the file
file.rename(from = paste0(wd,"/data/data.rds"), to = stringr::str_replace(file,".rda",".rds"))
}
return(NULL)
}
