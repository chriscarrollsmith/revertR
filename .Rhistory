library(tidyverse)
library(tidyquant)
library(revertR)
# Fetch and prep S&P 500 data
tickers <- tq_index("SP500") %>% filter(symbol != "-") %>% pull(symbol)
sp500_df <- prep_data(tickers, periods, include_today=FALSE)
# # Forecast returns using z-score of price difference from EMA
# plotdata <- data("sp500plotdata", package="revertR")
# sp500_1 <- analyze_data(sp500_df, plotdata, "z_score_stratum")
#
# # Forecast returns using z-score of 20-day moving average of price difference from EMA
# ma_plotdata <- data("sp500MAplotdata", package="revertR")
# sp500_2 <- analyze_data(sp500_df, ma_plotdata, "z_score_stratum")
# Forecast returns using the combo of both indicators
data(sp500DSplotdata, package="revertR")
sp500_3 <- analyze_data(sp500_df, sp500DSplotdata, "z_score_stratum", "diff_stratum")
#Classify and filter double strat results
classify_investment_thesis(sp500_3) %>%
group_by(type) %>%
arrange(desc(average_expected_return)) %>%
filter(row_number()<3) %>%
select(symbol,moving_average_20,moving_average_50,moving_average_100,moving_average_200,moving_average_500,average_expected_return,type) %>%
print()
#Classify and filter double strat results
classify_investment_thesis(sp500_3) %>%
group_by(type) %>%
arrange(desc(average_expected_return)) %>%
filter(row_number()<3) %>%
select(symbol,average_expected_return,type) %>%
print()
